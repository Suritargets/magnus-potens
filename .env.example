# Magnus & Potens — Law Firm
# ============================================================
# Kopieer naar .env.local en vul in. NOOIT committen naar git.
# ============================================================

# ─── APP ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Magnus & Potens"
NEXT_PUBLIC_APP_DESCRIPTION="Boutique legal and advisory counsel for those who move with purpose."
NODE_ENV=development

# ─── DATABASE (Neon PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── AUTH (Clerk) ────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── EMAIL (Nodemailer — eigen SMTP server) ──────────────────
# Suritargets host de mailserver zelf (Postfix / Exim / Postal).

# Productie — eigen mailserver:
SMTP_HOST=mail.magnus-potens.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@magnus-potens.com
SMTP_PASSWORD=mailbox-wachtwoord

# EHLO hostname — moet overeenkomen met PTR/rDNS record op de server
SMTP_HOSTNAME=mail.magnus-potens.com

# Self-signed cert? Zet op 'false'. Let's Encrypt? Weglaten (default true).
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Van-adres in de mail header
SMTP_FROM="Magnus & Potens <noreply@magnus-potens.com>"

# Inbox die de aanvragen ontvangt
CONTACT_EMAIL=counsel@magnus-potens.com

# ─── DKIM (sterk aanbevolen voor deliverability) ─────────────
# Genereer sleutels: openssl genrsa -out dkim-private.pem 2048
# Zet de public key als TXT record in DNS: default._domainkey.magnus-potens.com
# DKIM_DOMAIN=magnus-potens.com
# DKIM_SELECTOR=default
# DKIM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── Mailtrap (development / testen) ─────────────────────────
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=mailtrap-user
# SMTP_PASSWORD=mailtrap-pass
# SMTP_FROM="Magnus & Potens <test@magnus-potens.com>"

# ─── STORAGE (Cloudinary) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── CLERK WEBHOOK ───────────────────────────────────────────
CLERK_WEBHOOK_SECRET=whsec_...

# ─── PAYMENTS (Stripe) ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── RATE LIMITING (Upstash Redis) ──────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── ANALYTICS (optioneel) ───────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── VERCEL (alleen in CI/CD) ────────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
